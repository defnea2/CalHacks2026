{
  "name": "calhacks-visual-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visuals": "vitest run src/presentation src/visuals src/visual-math src/interactions",
    "test:state": "vitest run src/shared src/session",
    "check": "npm run typecheck && npm test && npm run build",
    "dev:teaching": "vite --config vite.teaching.config.ts",
    "build:teaching": "tsc --noEmit && vite build --config vite.teaching.config.ts",
    "test:teaching": "vitest run src/teaching",
    "test:live-model": "node scripts/smoke-model.mjs"
  },
  "dependencies": {
    "katex": "0.19.1",
    "mafs": "0.21.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
