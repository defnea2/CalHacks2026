{
  "name": "calhacks-visual-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter client dev",
    "build": "tsc --noEmit && pnpm --filter client build",
    "preview": "pnpm --filter client exec vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visuals": "vitest run src/presentation src/visuals src/visual-math src/interactions",
    "test:state": "vitest run src/shared src/session",
    "check": "npm run typecheck && npm test && npm run build",
    "test:teaching": "vitest run src/teaching",
    "dev:voice": "node scripts/dev.mjs",
    "stdb:start": "NO_PROXY=127.0.0.1,localhost node scripts/spacetime.mjs start --listen-addr 127.0.0.1:3000 --data-dir ./.spacetime-data",
    "stdb:publish": "node scripts/publish.mjs",
    "stdb:generate": "NO_PROXY=127.0.0.1,localhost node scripts/spacetime.mjs generate --lang typescript --out-dir client/src/module_bindings --module-path spacetimedb && NO_PROXY=127.0.0.1,localhost node scripts/spacetime.mjs generate --lang typescript --out-dir worker/src/module_bindings --module-path spacetimedb",
    "stt-proxy": "pnpm --filter stt-proxy start",
    "worker": "pnpm --filter worker start",
    "client": "pnpm --filter client dev",
    "test:voice": "pnpm -r --if-present test",
    "typecheck:voice": "pnpm -r --if-present typecheck",
    "test:e2e": "pnpm --filter e2e test:e2e"
  },
  "dependencies": {
    "katex": "0.19.1",
    "mafs": "0.21.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@9.15.9"
}
