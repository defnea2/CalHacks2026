# Required
CARTESIA_API_KEY=
ANTHROPIC_API_KEY=
# Optional LLM fallback (OpenRouter): needed only without ANTHROPIC_API_KEY or with LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional worker: LLM_PROVIDER=anthropic|openrouter, ANTHROPIC_MODEL=claude-haiku-5-5, ANTHROPIC_EFFORT=low|medium, ANTHROPIC_THINKING=disabled|adaptive, REPLY_MODE=lesson|tools, LESSON_EFFORT=low
# Optional STT (default: https://api.cartesia.ai + ink-whisper). For ink-2 via a PUBLIC stt-proxy:
# STT_BASE_URL=https://<host>/stt-proxy.php
# CARTESIA_STT_MODEL=ink-2
# Optional module: MEMORY_PROVIDER=anthropic|openrouter, ANTHROPIC_EXTRACTION_MODEL, DASHBOARD_EFFORT=low|medium, MEMORY_EVERY_N_TURNS=6, SIM_MAX_TURNS=8, DASHBOARD_INTERVAL_S=30, RETENTION_IMAGE_MIN=30 (off = keep photos), RETENTION_DAYS (default off)
# Deploy (docs/DEPLOY.md), usually set in the shell, not here:
# SPACETIME_SERVER=          # publish/seed-demo/simulate target: local (default) | maincloud (needs --yes-remote)
# SPACETIME_DB=              # database name (default voice-tutor)
# SPACETIME_URI=             # worker: ws://127.0.0.1:3000 (default) | wss://maincloud.spacetimedb.com
# AGENT_SECRET=              # generated into .env.local locally; a fresh shell value for the cloud
# AGENT_TOKEN_FILE=          # worker identity token file (default worker/.agent-token)
# INSIGHTS_KEY=              # module env, set for a shared deployment
# VITE_SPACETIME_URI=        # client build: baked server URI (?uri= overrides at runtime)
# VITE_SPACETIME_DB=         # client build: baked database (?db= overrides at runtime)
