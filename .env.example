# Required
CARTESIA_API_KEY=
ANTHROPIC_API_KEY=
# Optional LLM fallback (OpenRouter): needed only without ANTHROPIC_API_KEY or with LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional worker: LLM_PROVIDER=anthropic|openrouter, ANTHROPIC_MODEL=claude-haiku-5-5, ANTHROPIC_EFFORT=low|medium, ANTHROPIC_THINKING=disabled|adaptive, REPLY_MODE=lesson|tools, LESSON_EFFORT=low
# Optional STT (default: https://api.cartesia.ai + ink-whisper). For ink-2 via a PUBLIC stt-proxy:
# STT_BASE_URL=https://<host>/stt-proxy.php
# CARTESIA_STT_MODEL=ink-2
# Optional module: MEMORY_PROVIDER=anthropic|openrouter, ANTHROPIC_EXTRACTION_MODEL, DASHBOARD_EFFORT=low|medium, MEMORY_EVERY_N_TURNS=6, SIM_MAX_TURNS=8, DASHBOARD_INTERVAL_S=30
